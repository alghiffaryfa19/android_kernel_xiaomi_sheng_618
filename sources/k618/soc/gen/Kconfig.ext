menu "Qualcomm SoC Repostiory Configuration"

# SPDX-License-Identifier: GPL-2.0-only

menu "Gunyah arm64 drivers"
config GH_ARM64_DRV
	tristate "Gunyah arm64 support"
	depends on ARM64
	help
	  Gunyah drivers need arch specific support. Add support for
	  ARM64 features required by Gunyah virtualizaton drivers. All
	  arm64 specific features like GIC and reset reasons are handled
	  by drivers under this config.
endmenu


# SPDX-License-Identifier: GPL-2.0-only
menu "Platform selection"

config ARCH_CANOE
	bool "Enable support for Qualcomm Technologies, Inc. Canoe"
	depends on ARCH_QCOM
	help
	  This enables support for Qualcomm Technologies, Inc. Canoe
	  chipset. If you do not wish to build a kernel that runs on this
	  chipset or if you are unsure, say 'N' here.

config ARCH_ALOR
	bool "Enable support for Qualcomm Technologies, Inc. Alor"
	depends on ARCH_QCOM
	help
	  This enables support for Qualcomm Technologies, Inc. Alor
	  chipset. If you do not wish to build a kernel that runs on this
	  chipset or if you are unsure, say 'N' here.

config ARCH_CHORA
	bool "Enable support for Qualcomm Technologies, Inc. Chora"
	depends on ARCH_QCOM
	help
	  This enables support for Qualcomm Technologies, Inc. Chora
	  chipset. It is based on Kryo cores.

	  If you do not wish to build a kernel that runs on this
	  chipset or if you are unsure, say 'N' here.

config ARCH_MALABAR
	bool "Enable support for Qualcomm Technologies, Inc. Malabar"
	depends on ARCH_QCOM
	help
	  This enables support for Qualcomm Technologies, Inc. Malabar
	  chipset.

	  If you do not wish to build a kernel that runs on this
	  chipset or if you are unsure, say 'N' here.

config ARCH_QTI_VM
       bool "Enable Virtual Machines Support for Qualcomm Technologies, Inc."
       depends on ARCH_QCOM
       help
         This enables support for the Qualcomm Technologies, Inc.'s
         Virtual Machines. If you wish to build a kernel that doesn't
         require VM support or if you are unsure,
         say 'N' here.

